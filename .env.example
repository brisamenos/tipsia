# ===== Painel =====
PORT=3000
# Usuário e senha do primeiro acesso ao painel (depois dá para trocar a senha no painel)
ADMIN_USER=admin
ADMIN_PASS=troque-esta-senha
# Qualquer texto longo e aleatório
SESSION_SECRET=coloque-aqui-um-texto-grande-e-aleatorio

# ===== TsonTips =====
# Valor do cookie "sb-supabase-auth-token" (começa com base64-...).
# Também dá para colar/atualizar isso depois pelo painel, em Configurações.
TSON_COOKIE=
# Opcional: valor do cookie "_ch" do TsonTips, se a coleta der erro sem ele
TSON_CH_COOKIE=
# Opcional: o sistema descobre sozinho. Só preencha se der erro de "anon key"
TSON_ANON_KEY=

# ===== Telegram =====
# Token gerado pelo @BotFather
TELEGRAM_BOT_TOKEN=
# Opcional: o chat ID também pode ser configurado pelo painel (mande /id para o bot)
TELEGRAM_CHAT_ID=

# ===== Coleta =====
# Intervalo da coleta em segundos (recomendado: 60)
COLETA_INTERVALO=60
# Pasta do banco SQLite (no EasyPanel, monte um volume aqui)
DATA_DIR=/app/data
